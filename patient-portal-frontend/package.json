  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Edge versions",
      "last 2 Firefox versions",
      "last 2 Safari versions",
      "last 2 ios_saf versions",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.15.0",
    "jest-axe": "^9.0.0",
    "msw": "^1.3.5",
    "yaml": "^2.9.0"
  }
