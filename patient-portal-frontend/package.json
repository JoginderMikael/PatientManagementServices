    "release:verify": "npm run typecheck && npm run test:ci && npm run build:release",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "typecheck": "tsc --noEmit",
    "eject": "react-scripts eject"
