  "scripts": {
    "dev": "react-scripts start",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:release": "node scripts/build-release.mjs && node scripts/check-release-build.mjs && node scripts/verify-runtime.mjs",
