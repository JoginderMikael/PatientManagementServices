# Local development template. Copy to .env and replace every placeholder locally.
# Generate a signing key with: openssl rand -base64 32

JWT_SECRET=replace-with-a-base64-encoded-key-of-at-least-32-bytes
JWT_ISSUER=patient-management-auth
JWT_AUDIENCE=patient-management-api
JWT_ACCESS_TOKEN_TTL=PT15M
PUBLIC_API_DOCS_ENABLED=true
PUBLIC_METRICS_ENABLED=true
AUTH_SERVICE_DB_NAME=auth_service
AUTH_SERVICE_DB_USERNAME=auth_service
AUTH_SERVICE_DB_PASSWORD=replace-with-local-auth-db-password

PATIENT_SERVICE_DB_NAME=patient_service
PATIENT_SERVICE_DB_USERNAME=patient_service
PATIENT_SERVICE_DB_PASSWORD=replace-with-local-patient-db-password

BILLING_SERVICE_ADDRESS=billing-service
BILLING_SERVICE_GRPC_PORT=9001
BILLING_SERVICE_DB_NAME=billing_service
BILLING_SERVICE_DB_USERNAME=billing_service
BILLING_SERVICE_DB_PASSWORD=replace-with-local-billing-db-password
APPOINTMENT_SERVICE_DB_NAME=appointment_service
APPOINTMENT_SERVICE_DB_USERNAME=appointment_service
APPOINTMENT_SERVICE_DB_PASSWORD=replace-with-local-appointment-db-password
EHR_SERVICE_DB_NAME=ehr_service
EHR_SERVICE_DB_USERNAME=ehr_service
EHR_SERVICE_DB_PASSWORD=replace-with-local-ehr-db-password
NOTIFICATION_SERVICE_DB_NAME=notification_service
NOTIFICATION_SERVICE_DB_USERNAME=notification_service
NOTIFICATION_SERVICE_DB_PASSWORD=replace-with-local-notification-db-password
AUDIT_SERVICE_DB_NAME=audit_service
AUDIT_SERVICE_DB_USERNAME=audit_service
AUDIT_SERVICE_DB_PASSWORD=replace-with-local-audit-db-password
NOTIFICATION_PROVIDER_WEBHOOK_URL=
NOTIFICATION_PROVIDER_BEARER_TOKEN=
NOTIFICATION_MAX_ATTEMPTS=5
AUDIT_CAPTURE_ENABLED=true

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_SQL_INIT_MODE=never
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/dev-migration
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
LOGGING_LEVEL_ROOT=info

KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
KAFKA_NODE_ID=1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password

# Phase 3 isolated PostgreSQL databases
INSURANCE_SERVICE_DB_PASSWORD=replace-with-local-insurance-password
INVENTORY_PHARMACY_SERVICE_DB_PASSWORD=replace-with-local-pharmacy-password
PATIENT_PORTAL_SERVICE_DB_PASSWORD=replace-with-local-portal-password
STAFF_DASHBOARD_SERVICE_DB_PASSWORD=replace-with-local-staff-password

FRONTEND_PORT=8085
